/* =========================
   HELPERS
========================= */

function goToRegister() {

  document
    .getElementById(
      "register"
    )
    .scrollIntoView({
      behavior: "smooth"
    });

}


function showMessage(
  elementId,
  message
) {

  document.getElementById(
    elementId
  ).textContent =
    message;

}


function fileToBase64(file) {

  return new Promise(
    (resolve, reject) => {

      const reader =
        new FileReader();


      reader.onload =
        () =>
          resolve(
            reader.result
          );


      reader.onerror =
        reject;


      reader.readAsDataURL(file);

    }
  );

}


function escapeHTML(value) {

  const div =
    document.createElement(
      "div"
    );

  div.textContent =
    value ?? "";

  return div.innerHTML;

}


